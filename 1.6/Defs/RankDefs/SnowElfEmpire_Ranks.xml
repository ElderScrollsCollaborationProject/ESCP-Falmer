<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ESCP.Ranks.RankTrackDef>
        <defName>ESCP_RankTrack_SnowElfEmpire</defName>
        <label>the Chantry of Auri-El ranks</label>
        <rootTier>ESCP_Rank_SnowElfEmpire_Acolyte</rootTier>
        <owningFaction>ESCP_Faction_Snow_Elf_Empire</owningFaction>
        <collectiveNoun>the Chantry of Auri-El</collectiveNoun>
        <drillLabel>Sunlight Drill</drillLabel>
        <drillDesc>Train with any colonist. Both stop what they are doing and both gain skill XP. Once per day.</drillDesc>
        <studyLabel>Recite the Hymns</studyLabel>
        <studyDesc>Study with another member. Both gain skill XP. Once per day.</studyDesc>
        <inspectLabel>Inspect Their Glass</inspectLabel>
        <inspectDesc>Look over a junior member's gear. Good upkeep earns praise and poor upkeep earns a sharp word.</inspectDesc>
        <punishLabel>Send to Tend the Shrines...</punishLabel>
        <punishDesc>Set a junior member to tedious labor for a failure, souring their mood. Once per day per member.</punishDesc>
        <rallyLabel>Auri-El's Light!</rallyLabel>
        <rallyDesc>Call on {0} to fight harder for a short while. Once every few days.</rallyDesc>
        <fallInLabel>Gather in the Light</fallInLabel>
        <fallInDesc>Order {0} to gather behind you, up to four deep. They hold position until released.</fallInDesc>
        <dismissLabel>Go in Auri-El's Grace</dismissLabel>
        <dismissDesc>Release {0} so they can return to their duties.</dismissDesc>
    </ESCP.Ranks.RankTrackDef>

    <ESCP.Ranks.RankTierDef>
        <defName>ESCP_Rank_SnowElfEmpire_Acolyte</defName>
        <label>acolyte</label>
        <description>Has come to serve Auri-El and the Snow Elves.</description>
        <nextTierOptions>
            <li>ESCP_Rank_SnowElfEmpire_Initiate</li>
        </nextTierOptions>
    </ESCP.Ranks.RankTierDef>

