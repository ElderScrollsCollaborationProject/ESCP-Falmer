        <degreeDatas>
            <li>
                <label>winter courtier</label>
                <description>Comfortable at the Snow Prince's table, where a slight could wait a hundred years to be repaid. They rarely raise their voice.</description>
                <statOffsets>
                    <SocialImpact>0.1</SocialImpact>
                    <NegotiationAbility>0.08</NegotiationAbility>
                </statOffsets>
                <skillGains>
                    <Social>2</Social>
                </skillGains>
            </li>
        </degreeDatas>
