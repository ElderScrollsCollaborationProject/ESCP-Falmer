            <li>
                <label>Chantry scholar</label>
                <description>Raised on the Chantry's long liturgies and the mathematics of the sun. Their reserves of magicka are deep and their memory for ritual is flawless.</description>
                <statOffsets>
                    <ESCP_MagickaMax>25</ESCP_MagickaMax>
                    <GlobalLearningFactor>0.06</GlobalLearningFactor>
                </statOffsets>
                <skillGains>
                    <Intellectual>2</Intellectual>
                </skillGains>
            </li>
        </degreeDatas>
    </TraitDef>

    <TraitDef>
        <defName>ESCP_Trait_SnowElf_Courtly</defName>
