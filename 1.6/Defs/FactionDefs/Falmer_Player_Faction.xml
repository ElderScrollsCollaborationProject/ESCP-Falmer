<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <FactionDef ParentName="PlayerFactionBase">
        <defName>ESCP_Faction_Falmer_Player</defName>
        <label>Sundered Brood</label>
        <description>A small brood driven from its hive. They do not know the word for settlement, but have nonetheless started building one.</description>
        <isPlayer>true</isPlayer>
        <techLevel>Neolithic</techLevel>
        <basicMemberKind>ESCP_Pawnkind_Falmer_Settler</basicMemberKind>
        <pawnSingular>Falmer</pawnSingular>
        <pawnsPlural>Falmer</pawnsPlural>
        <leaderTitle>Hive Mother</leaderTitle>
        <factionIconPath>World/WorldObjects/Expanding/Empire</factionIconPath>
        <colorSpectrum>
            <li>(0.55, 0.65, 0.7)</li>
        </colorSpectrum>
        <xenotypeSet MayRequire="Ludeon.RimWorld.Biotech">
            <xenotypeChances>
                <ESCP_Xenotype_Falmer>1</ESCP_Xenotype_Falmer>
            </xenotypeChances>
        </xenotypeSet>
        <allowedCultures>
            <li>ESCP_Culture_Falmer</li>
        </allowedCultures>
        <backstoryFilters>
            <li>
                <categories>
                    <li>ESCP_Backstory_Falmer_Child</li>
                    <li>ESCP_Backstory_Falmer_Citizen</li>
                    <li>ESCP_Backstory_Falmer_Military</li>
                    <li>ESCP_Backstory_Falmer_Mage</li>
                </categories>
            </li>
        </backstoryFilters>
    </FactionDef>

</Defs>
